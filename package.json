{
	"name": "arrowpack",
	"version": "0.2.4",
	"description": "A unique web bundler that focuses on HTML files and website speed and simplicity",
	"keywords": [
		"web"
	],
	"author": "Laurence Jackson <contact@redstarbird.com>",
	"homepage": "https://github.com/redstarbird/arrowstack/tree/main/packages/ArrowPack#readme",
	"license": "MIT",
	"main": "src/ArrowPack.js",
	"directories": {
		"lib": "src",
		"test": "__tests__"
	},
	"files": [
		"bin",
		"*.js",
		"src/js",
		"src/SettingsSingleton/SettingsSingleton.js",
		"build/CFunctions.wasm"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/redstarbird/arrowpack.git"
	},
	"scripts": {
		"build:native:release": "cmake-js build --out build",
		"build:native:debug": "cmake-js build --debug --out build",
		"build:wasm:release": "emcmake cmake -B build/wasm -DCMAKE_BUILD_TYPE=Release && cmake --build build/wasm",
		"build:wasm:debug": "emcmake cmake -B build/wasm -DCMAKE_BUILD_TYPE=Debug && cmake --build build/wasm",
		"build-release": "npm run build:native:release && npm run build:wasm:release",
		"build-debug": "npm run build:native:debug && npm run build:wasm:debug",
		"build": "npm run build-debug",
		"prepublishOnly": "npm run build-release",
		"test": "node ./__tests__/ArrowPack.test.js",
		"lines": "node ./Scripts/TotalLinesOfCode.js",
		"format": "git ls-files '*.c' '*.h' '*.js' ':(exclude)build/' ':(exclude)example/' | xargs clang-format -style=file -i"
	},
	"bin": {
		"arrowpack": "bin/arrowpack.js"
	},
	"dependencies": {
		"arrowargs": "^0.0.4",
		"assert": "^2.0.0",
		"chalk": "^4.1.2",
		"chokidar": "^5.0.0",
		"cmake-js": "^8.0.0",
		"codependency": "^2.1.0",
		"helloworldify": "^1.0.0",
		"jshint": "^2.13.5",
		"ws": "^8.12.1"
	},
	"devDependencies": {
		"node-api-headers": "^1.9.0"
	}
}
